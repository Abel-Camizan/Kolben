# Copia este archivo como .env y completa tus datos (.env no se sube a git)
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_NAME=kolben

# Seguridad (JWT): usa una cadena larga y aleatoria
